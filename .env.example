# Copie este arquivo para ".env.local" e preencha com as credenciais do seu
# projeto Supabase (Project Settings > API no dashboard do Supabase).
#
# Variáveis NEXT_PUBLIC_* ficam embutidas no bundle do navegador — a anon key
# é segura para expor no client; o acesso real aos dados será controlado pelas
# policies de RLS que vamos criar na Fase 2.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
